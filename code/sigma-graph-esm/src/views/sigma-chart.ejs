<!doctype html>
<html lang="en">
  <!-- Head -->
  <head>
    <meta charset="UTF-8" />
    <title>Sigma Charts</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sigma.js/2.4.0/sigma.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/graphology/0.25.4/graphology.umd.min.js"></script>
    <!-- Load Graphology standard library (includes layouts) -->
    <script src="https://cdn.jsdelivr.net/npm/graphology-library/dist/graphology-library.min.js"></script>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
      /* we need this to make the chart fill only the area of the div even if we resize the page so we do not need to use scrollbars */
      #sigma-container {
          width: 80%;
          height: 80%;
          margin: 0 !important;
          padding: 0 !important;
          overflow: hidden;
      }
    </style>
  </head>

  <!-- Body -->
  <body>
    <div>Sigma chart stuff...<%= title %></div>
    <div id="sigma-container" class="border border-solid vh-75"></div>
  </body>

  <script>
        // Use EJS tag safely to embed server data into client-side JavaScript
        const serverData = <%- JSON.stringify(graphData) %>;

        // Initialize a Graphology instance
        const graph = new graphology.Graph();

        // Populate nodes from server data
        serverData.nodes.forEach(node => {
            graph.addNode(node.id, {
                label: node.label,
                x: node.x,
                y: node.y,
                size: node.size,
                color: node.color
            });
        });

        // Populate edges from server data
        serverData.edges.forEach(edge => {
            graph.addEdge(edge.source, edge.target, {
                id: edge.id,
                color: edge.color,
                size: edge.size
            });
        });

        // Instantiate Sigma.js to bind the graph to the DOM container
        const container = document.getElementById("sigma-container");
        const renderer = new Sigma(graph, container);
    </script>
</html>
